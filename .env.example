# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kemebos?retryWrites=true&w=majority
MONGODB_DB=kemebos

# Google AI Studio key (chat + embeddings)
GEMINI_API_KEY=your-gemini-key

# Groq key (fallback chat model)
GROQ_API_KEY=your-groq-key

# Model choices (change here, no code edits needed)
GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
GEMINI_THINKING=minimal
LLM_ORDER=gemini,groq
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Signs login tokens. Any long random string; keep it secret.
JWT_SECRET=replace-with-a-long-random-string

# First admin account, created by the seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# "true" = the frontend uses built-in mock data (offline demo fallback)
NEXT_PUBLIC_USE_MOCK=false

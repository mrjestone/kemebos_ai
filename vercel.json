{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.next/**,.venv/**,tests/**,scripts/**,data/**,app/**,components/**,lib/**,public/**,**/__pycache__/**}"
    }
  },
  "regions": [
    "cpt1"
  ]
}
